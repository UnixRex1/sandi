from __future__ import annotations

import argparse
import os
import platform
import shutil
import subprocess
import sys
import tempfile
from dataclasses import dataclass
from datetime import datetime, timedelta
from pathlib import Path
from typing import Iterable, Sequence


@dataclass(frozen=True, order=True)
class Package:
    name: str
    kinds: frozenset[str]


class PackageManager:
    CACHE_DIR = Path.home() / ".sandi" / "cache"
    CACHE_FILE = CACHE_DIR / "package.list"
    MAX_CACHE_AGE = timedelta(days=1)
    MIN_CACHE_SIZE = 100

    def __init__(self) -> None:
        self.os_name = platform.system()
        self.brew = self._find_executable(
            "brew",
            fallbacks=("/opt/homebrew/bin/brew", "/usr/local/bin/brew"),
        )
        self.linux_manager = self._find_linux_package_manager()
        self.CACHE_DIR.mkdir(parents=True, exist_ok=True)

    @staticmethod
    def _find_executable(
        name: str,
        *,
        fallbacks: Sequence[str] = (),
    ) -> str | None:
        executable = shutil.which(name)
        if executable:
            return executable

        for candidate in fallbacks:
            if Path(candidate).is_file() and os.access(candidate, os.X_OK):
                return candidate

        return None

    def _find_linux_package_manager(self) -> str | None:
        if self.os_name != "Linux":
            return None

        for manager in ("dnf", "yum", "apt-get"):
            executable = shutil.which(manager)
            if executable:
                return executable

        return None

    @staticmethod
    def _run(
        command: Sequence[str],
        *,
        capture_output: bool = True,
        check: bool = True,
    ) -> subprocess.CompletedProcess[str]:
        try:
            return subprocess.run(
                list(command),
                check=check,
                text=True,
                stdout=subprocess.PIPE if capture_output else None,
                stderr=subprocess.PIPE,
            )
        except FileNotFoundError as exc:
            raise RuntimeError(f"Command not found: {command[0]}") from exc
        except subprocess.CalledProcessError as exc:
            output = "\n".join(
                part.strip()
                for part in (exc.stdout or "", exc.stderr or "")
                if part.strip()
            )
            message = f"Command failed ({exc.returncode}): {' '.join(command)}"
            if output:
                message += f"\n{output}"
            raise RuntimeError(message) from exc

    @staticmethod
    def _sudo_prefix() -> list[str]:
        if hasattr(os, "geteuid") and os.geteuid() == 0:
            return []

        sudo = shutil.which("sudo")
        if not sudo:
            raise RuntimeError(
                "Administrative privileges are required, but sudo was not found."
            )

        return [sudo]

    def cache_needs_update(self) -> bool:
        try:
            stat = self.CACHE_FILE.stat()
        except FileNotFoundError:
            return True

        if stat.st_size < self.MIN_CACHE_SIZE:
            return True

        age = datetime.now() - datetime.fromtimestamp(stat.st_mtime)
        return age > self.MAX_CACHE_AGE

    def update_cache(self) -> None:
        if self.os_name == "Darwin":
            packages = self._collect_macos_packages()
        elif self.os_name == "Linux":
            packages = self._collect_linux_packages()
        else:
            raise RuntimeError(f"Unsupported operating system: {self.os_name}")

        if not packages:
            raise RuntimeError("Package manager returned an empty package list.")

        self._write_cache(packages)
        print(f"Cache updated successfully with {len(packages):,} entries.")

    def _collect_macos_packages(self) -> list[Package]:
        if not self.brew:
            raise RuntimeError(
                "Homebrew was not found. Install it from https://brew.sh first."
            )

        print("Updating package cache using Homebrew ...")

        formulae = {
            line.strip()
            for line in self._run([self.brew, "formulae"]).stdout.splitlines()
            if line.strip()
        }
        casks = {
            line.strip()
            for line in self._run([self.brew, "casks"]).stdout.splitlines()
            if line.strip()
        }

        index: dict[str, set[str]] = {}

        for name in formulae:
            index.setdefault(name, set()).add("formula")

        for name in casks:
            index.setdefault(name, set()).add("cask")

        return [
            Package(name, frozenset(kinds))
            for name, kinds in sorted(index.items())
        ]

    def _collect_linux_packages(self) -> list[Package]:
        if not self.linux_manager:
            raise RuntimeError("No supported Linux package manager was found.")

        manager_name = Path(self.linux_manager).name
        print(f"Updating package cache using {manager_name} ...")

        if manager_name in {"dnf", "yum"}:
            return self._collect_rpm_packages()

        if manager_name == "apt-get":
            return self._collect_apt_packages()

        raise RuntimeError(f"Unsupported Linux package manager: {manager_name}")

    def _collect_rpm_packages(self) -> list[Package]:
        assert self.linux_manager is not None

        self._run(
            [*self._sudo_prefix(), self.linux_manager, "makecache"],
            capture_output=False,
        )

        output = self._run(
            [self.linux_manager, "list", "available", "--quiet"]
        ).stdout

        package_names: set[str] = set()

        for raw_line in output.splitlines():
            line = raw_line.strip()
            if not line or line.startswith(("Available Packages", "Last metadata")):
                continue

            fields = line.split()
            if not fields:
                continue

            name_arch = fields[0]
            name = name_arch.rsplit(".", 1)[0] if "." in name_arch else name_arch

            if name:
                package_names.add(name)

        return [
            Package(name, frozenset({"package"}))
            for name in sorted(package_names)
        ]

    def _collect_apt_packages(self) -> list[Package]:
        assert self.linux_manager is not None

        self._run(
            [*self._sudo_prefix(), self.linux_manager, "update"],
            capture_output=False,
        )

        apt_cache = shutil.which("apt-cache")
        if not apt_cache:
            raise RuntimeError("apt-cache was not found.")

        output = self._run([apt_cache, "pkgnames"]).stdout
        package_names = {
            line.strip()
            for line in output.splitlines()
            if line.strip()
        }

        return [
            Package(name, frozenset({"package"}))
            for name in sorted(package_names)
        ]

    def _write_cache(self, packages: Iterable[Package]) -> None:
        self.CACHE_DIR.mkdir(parents=True, exist_ok=True)

        temporary_path: Path | None = None

        try:
            with tempfile.NamedTemporaryFile(
                mode="w",
                encoding="utf-8",
                dir=self.CACHE_DIR,
                prefix=f".{self.CACHE_FILE.name}.",
                delete=False,
            ) as handle:
                temporary_path = Path(handle.name)

                for package in packages:
                    kinds = ",".join(sorted(package.kinds))
                    handle.write(f"{package.name}|{kinds}\n")

                handle.flush()
                os.fsync(handle.fileno())

            temporary_path.replace(self.CACHE_FILE)
        finally:
            if temporary_path and temporary_path.exists():
                temporary_path.unlink(missing_ok=True)

    def load_index(self) -> list[Package]:
        if not self.CACHE_FILE.exists():
            raise RuntimeError(f"Cache file not found: {self.CACHE_FILE}")

        default_kind = "formula" if self.os_name == "Darwin" else "package"
        packages: list[Package] = []

        with self.CACHE_FILE.open(encoding="utf-8") as handle:
            for line_number, raw_line in enumerate(handle, start=1):
                line = raw_line.strip()
                if not line:
                    continue

                name_part, separator, kinds_part = line.partition("|")
                name = name_part.strip()

                if not name:
                    print(
                        f"Warning: ignoring malformed cache line {line_number}.",
                        file=sys.stderr,
                    )
                    continue

                kinds = {
                    kind.strip()
                    for kind in kinds_part.split(",")
                    if kind.strip()
                } if separator else {default_kind}

                packages.append(
                    Package(name, frozenset(kinds or {default_kind}))
                )

        return packages

    def search(self, terms: Sequence[str]) -> list[Package]:
        normalized_terms = [term.casefold() for term in terms if term.strip()]
        packages = self.load_index()

        if not normalized_terms:
            return packages

        return [
            package
            for package in packages
            if all(term in package.name.casefold() for term in normalized_terms)
        ]

    def install(self, package: Package, *, assume_yes: bool = False) -> bool:
        try:
            if self.os_name == "Darwin":
                self._install_macos(package, assume_yes=assume_yes)
            elif self.os_name == "Linux":
                self._install_linux(package)
            else:
                raise RuntimeError(f"Unsupported operating system: {self.os_name}")
        except RuntimeError as exc:
            print(f"\nFailed to install {package.name}:\n{exc}", file=sys.stderr)
            return False

        return True

    def _install_macos(self, package: Package, *, assume_yes: bool) -> None:
        if not self.brew:
            raise RuntimeError("Homebrew was not found.")

        chosen_kind = self._choose_macos_kind(package, assume_yes=assume_yes)
        print(f"\n=== Installing {package.name} ({chosen_kind}) ===\n")

        command = [self.brew, "install"]
        if chosen_kind == "cask":
            command.append("--cask")
        command.append(package.name)

        self._run(command, capture_output=False)

    @staticmethod
    def _choose_macos_kind(package: Package, *, assume_yes: bool) -> str:
        if len(package.kinds) == 1:
            return next(iter(package.kinds))

        if assume_yes or not sys.stdin.isatty():
            return "formula"

        try:
            response = input(
                f"\nBoth a formula and cask exist for '{package.name}'. "
                "Install [f]ormula or [c]ask? [f]: "
            ).strip().casefold()
        except (EOFError, KeyboardInterrupt):
            print()
            return "formula"

        return "cask" if response in {"c", "cask"} else "formula"

    def _install_linux(self, package: Package) -> None:
        if not self.linux_manager:
            raise RuntimeError("No supported Linux package manager was found.")

        print(f"\n=== Installing {package.name} ===\n")

        self._run(
            [
                *self._sudo_prefix(),
                self.linux_manager,
                "install",
                "-y",
                package.name,
            ],
            capture_output=False,
        )


class PackageInstaller:
    def __init__(self, args: argparse.Namespace) -> None:
        self.args = args
        self.manager = PackageManager()

    def execute(self) -> int:
        try:
            if self.args.refresh or self.manager.cache_needs_update():
                print("\nRefreshing package cache ...\n")
                self.manager.update_cache()

            terms = list(self.args.terms)

            if not terms:
                terms = self._prompt_for_terms()

            if not terms:
                print("No search terms provided.")
                return 1

            results = self.manager.search(terms)
        except RuntimeError as exc:
            print(f"Error: {exc}", file=sys.stderr)
            return 1

        if not results:
            print("\nNo packages found.\n")
            return 1

        self._display_results(results)

        if self.args.install_all:
            selected = results
        else:
            selected = self._prompt_for_selection(results)

        if not selected:
            return 0

        failures = sum(
            not self.manager.install(package, assume_yes=self.args.yes)
            for package in selected
        )

        if failures:
            print(
                f"\n{failures} installation(s) failed.",
                file=sys.stderr,
            )
            return 1

        return 0

    @staticmethod
    def _prompt_for_terms() -> list[str]:
        try:
            return input("Enter search terms separated by spaces: ").split()
        except (EOFError, KeyboardInterrupt):
            print()
            return []

    @staticmethod
    def _display_results(results: Sequence[Package]) -> None:
        for index, package in enumerate(results, start=1):
            kinds = ""
            if len(package.kinds) > 1:
                kinds = f" [{'/'.join(sorted(package.kinds))}]"
            print(f"{index:>4}. {package.name}{kinds}")

    @staticmethod
    def _prompt_for_selection(
        results: Sequence[Package],
    ) -> list[Package]:
        while True:
            try:
                response = input(
                    "\nEnter number(s) separated by spaces, "
                    "[a]ll, or [q]uit: "
                ).strip()
            except (EOFError, KeyboardInterrupt):
                print("\nExiting ...")
                return []

            normalized = response.casefold()

            if normalized in {"q", "x", "quit", "exit"}:
                return []

            if normalized in {"a", "all"}:
                return list(results)

            try:
                indices = [int(value) for value in response.split()]
            except ValueError:
                print("Invalid input. Enter package numbers separated by spaces.")
                continue

            if not indices:
                print("Enter at least one package number.")
                continue

            invalid = [
                index
                for index in indices
                if index < 1 or index > len(results)
            ]
            if invalid:
                print(
                    "Invalid package number(s): "
                    + ", ".join(str(index) for index in invalid)
                )
                continue

            # Preserve the user's order while avoiding duplicate installations.
            unique_indices = list(dict.fromkeys(indices))
            return [results[index - 1] for index in unique_indices]


def build_argument_parser() -> argparse.ArgumentParser:
    parser = argparse.ArgumentParser(
        description=(
            "Search Homebrew, DNF, YUM, or APT package indexes and "
            "interactively install matching packages."
        )
    )
    parser.add_argument(
        "terms",
        nargs="*",
        help="Search terms; every term must appear in the package name.",
    )
    parser.add_argument(
        "-r",
        "--refresh",
        action="store_true",
        help="Refresh the package cache before searching.",
    )
    parser.add_argument(
        "-a",
        "--all",
        dest="install_all",
        action="store_true",
        help="Install every matching package without prompting for selection.",
    )
    parser.add_argument(
        "-y",
        "--yes",
        action="store_true",
        help=(
            "Use non-interactive defaults where a choice is required. "
            "For a Homebrew formula/cask collision, choose the formula."
        ),
    )
    return parser


def main() -> int:
    parser = build_argument_parser()
    args = parser.parse_args()
    return PackageInstaller(args).execute()


if __name__ == "__main__":
    raise SystemExit(main())
